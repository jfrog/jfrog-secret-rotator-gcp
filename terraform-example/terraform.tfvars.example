project_id      = "my-gcp-project"
region          = "us-central1"
secret_name     = "jfrog-access-token"

# Rotation schedule — set JFrog identity mapping expires_in to at least 30% longer (46800 for this period)
rotation_period = "36000s" # 10 hours → use expires_in: 46800 in JFrog OIDC mapping

# JFrog OIDC configuration
jfrog_host        = "myregistry.jfrog.io"
provider_name     = "gcp-oidc"
create_jfrog_oidc = true
jfrog_user        = "gcp-user" # must exist in JFrog when create_jfrog_oidc is true
# jfrog_access_token          = "..."  # or set JFROG_ACCESS_TOKEN env var
# bootstrap_jfrog_token       = "..."  # optional initial secret version; defaults to the placeholder "dummy-token" until the first rotation

# Optional overrides
# jfrog_token_expires_in      = 46800  # defaults to rotation_period × 1.3
# oidc_mapping_name           = "gcp-oidc"
# oidc_mapping_priority       = 1
# pubsub_topic_name           = "jfrog-secret-rotation"
# function_name               = "secret-rotation-function"
# function_service_account_id = "secret-rotator-sa"
# audience                    = "jfrog_user1"
# prev_secret_action          = "KEEP"  # default is DESTROY; set KEEP or DISABLE to retain old versions - see docs/manual-setup.md
# jfrog_debug                 = false
# next_rotation_time          = "2026-07-09T12:00:00Z"

# Optional Artifact Registry connector + Cloud Run Nginx example
# First apply waits for the scheduled SECRET_ROTATE (~6 minutes) before creating the connector.
# create_cloud_run_example    = true
# create_jfrog_docker_repos   = true   # set false to reuse existing JFrog Docker repos
# jfrog_docker_local_key      = "connector-docker-local"
# jfrog_docker_remote_key     = "connector-docker-remote"
# jfrog_docker_virtual_key    = "connector-docker"
# connector_repository_id     = "jfrog-docker-connector"
# cloud_run_service_name      = "nginx-via-jfrog-connector"
# cloud_run_image_name        = "nginx"
# cloud_run_image_tag         = "latest"  # pulled from Docker Hub through Artifactory
